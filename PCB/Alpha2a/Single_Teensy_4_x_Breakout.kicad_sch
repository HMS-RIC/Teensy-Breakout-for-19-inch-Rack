		(uuid "2e0fe11a-7bac-4dd3-baf1-c9dda51cc9bf")
	)
	(text "Cin is recommended\nCout of at least 1 uF is required for stability.\nCout should have ~1 Ohm ESR (not lower) and resonance above 1 MHz.\nDo not use low ESR ceramics, Tantalum or electrolytic OK."
		(exclude_from_sim no)
		(at 25.4 63.5 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "61a6ba60-2ee1-4176-ac63-dc37b5bb1100")
	)
	(text "Only DIO pins are 5V tolerant. Do not\napply more than 3.3V to A10, A11,\nA21, A22, A25, A26, AREF, Program\nor Reset"
